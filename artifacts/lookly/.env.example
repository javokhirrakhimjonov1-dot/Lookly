# Public Supabase values: safe to embed in the Expo web/mobile client.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Leave blank when the web app and API are deployed together on Railway.
# For a separately hosted web build, set this to https://your-api-domain/api
# EXPO_PUBLIC_API_URL=
