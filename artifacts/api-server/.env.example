# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional model overrides
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# Gemini's dedicated image-generation model (requires the paid Gemini tier).
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/lookly

# Supabase values used only to validate signed-in users at the API boundary.
# These are publishable values, not the service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# In production, set this to the public web app URL (no trailing slash).
# For multiple web URLs, separate them with commas.
CORS_ORIGIN=https://your-lookly-domain.example
